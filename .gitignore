# Do not track objects or archives
*.o
*.a
*.orig
*.core
dependencies

# Do not track Makefiles; these are autogenerated
*Makefile

# Do not track logfiles
*.log
*.status

# Do not track backup files
*~

# Do not track autogenerated config headers
CAROM_config.h
FCMangle.h

# Do not track executables
build
build_pic
buildArdra

# Do not track the generated environment setup script (machine-specific paths;
# regenerated by install_librom.sh)
librom_env.sh

# Do not track docs/latex and docs/html
docs/latex
docs/html

# Do not track results
regression_tests/results
